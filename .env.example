# Backend server URL (defaults to https://bar3-server.onrender.com)
VUE_APP_SERVER_URL=https://bar3-server.onrender.com

# Discord OAuth2 application client ID (required for Discord authentication)
# Create an application at https://discord.com/developers/applications
# Set the redirect URI to: <your-site-origin>/auth/discord/callback
VUE_APP_DISCORD_CLIENT_ID=
